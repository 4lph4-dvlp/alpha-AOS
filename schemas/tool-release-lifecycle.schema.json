{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alpha-aos.local/schemas/tool-release-lifecycle.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "operationId",
    "sequence",
    "occurredAt",
    "kind",
    "toolId",
    "reviewedRelease"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "eventId": { "$ref": "#/$defs/id" },
    "operationId": { "$ref": "#/$defs/id" },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "occurredAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$",
      "maxLength": 32
    },
    "kind": {
      "enum": [
        "started",
        "evidence-recorded",
        "verification-pending",
        "activated",
        "postcheck-passed",
        "postcheck-failed",
        "recovery-started",
        "recovered",
        "recovery-failed",
        "cancelled"
      ]
    },
    "toolId": { "$ref": "#/$defs/tool" },
    "reviewedRelease": { "$ref": "#/$defs/reviewedRelease" },
    "activeIdentity": { "$ref": "#/$defs/activeIdentity" },
    "lastGoodIdentity": {
      "anyOf": [
        { "$ref": "#/$defs/lastGoodIdentity" },
        { "type": "null" }
      ]
    },
    "evidenceFingerprint": { "$ref": "#/$defs/digest" },
    "tiers": {
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/tier" }
    },
    "overallState": {
      "enum": ["pass", "pending", "failed", "not-run"]
    },
    "pendingReason": { "type": "string", "maxLength": 512 },
    "failureReason": { "type": "string", "maxLength": 512 },
    "nextAction": { "type": "string", "maxLength": 512 },
    "artifactRefs": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "maxLength": 512 }
    },
    "recoveryScope": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "maxLength": 256 }
    },
    "unrecoveredEffects": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "maxLength": 256 }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "tool": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^(cua-driver|gsd|ecc|mcp:(context7|exa|firecrawl)|bridge:pi)$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewedRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolId", "release", "artifact", "integrity", "digest"],
      "properties": {
        "toolId": { "$ref": "#/$defs/tool" },
        "release": { "$ref": "#/$defs/version" },
        "artifact": { "type": "string", "maxLength": 256 },
        "integrity": { "type": "string", "maxLength": 256 },
        "digest": { "$ref": "#/$defs/digest" },
        "planDigest": { "type": "string", "maxLength": 128 }
      }
    },
    "activeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["installationId", "version", "pathAlias"],
      "properties": {
        "installationId": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "pathAlias": { "type": "string", "maxLength": 256 }
      }
    },
    "lastGoodIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["installationId", "version"],
      "properties": {
        "installationId": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" }
      }
    },
    "tier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "state", "method", "resultDigest"],
      "properties": {
        "tier": {
          "enum": ["installation", "discovery", "protocol-schema", "invocation"]
        },
        "state": {
          "enum": ["pass", "pending", "failed", "not-run"]
        },
        "method": { "type": "string", "maxLength": 128 },
        "resultDigest": { "$ref": "#/$defs/digest" },
        "evaluatedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$",
          "maxLength": 32
        },
        "reason": { "type": "string", "maxLength": 512 }
      }
    }
  }
}
