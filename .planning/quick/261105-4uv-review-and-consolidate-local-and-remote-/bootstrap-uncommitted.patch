+test("cancel publication keeps its inode until a contending worker consumes it, then observes pinned terminal cancellation", { timeout: 30_000 }, async () => {
+  const savedExitCode = process.exitCode;
+  const { stateRoot, cleanup } = await createWorkerTestState();
+  let worker: Promise<void> | undefined;
+  let timer: NodeJS.Timeout | undefined;
+  try {
+    const jobId = "job-0000000000000042";
+    const { ownerToken, specDigest } = await setupJobFixture({ stateRoot, jobId, args: ["-e", "setInterval(()=>{},1000)"] });
+    let acknowledge!: (record: CommandJobRecord) => void;
+    const running = new Promise<CommandJobRecord>((resolve) => { acknowledge = resolve; });
+    let decide!: (outcome: "serialized" | "consumed") => void;
+    const consumption = new Promise<"serialized" | "consumed">((resolve) => { decide = resolve; });
+    const deadline = new Promise<never>((_, reject) => { timer = setTimeout(() => reject(new Error("cancel interleaving barrier deadline")), 12_000); });
+    let observedClosure = false;
+    worker = runJobWorker({ stateRoot, jobId, ownerToken, _testSeams: {
+      onAfterAck: (record) => { acknowledge(record); },
+      onCancelCleanupContended: () => { decide("serialized"); },
+      onBeforeTerminalWrite: () => { decide("consumed"); },
+      onProcessOutcome: (result) => { observedClosure = result.closeConfirmed === true && (result.exitCode !== null || result.signal !== null); },
+    } });
+    const acknowledged = await Promise.race([running, deadline]);
+    let publicationFenced = false;
+    const receipt = await cancelCommandJob({ stateRoot, jobId, timeoutMs: 10_000, _testBarrier: async (phase, path) => {
+      if (phase !== "write:after-rename") return;
+      const outcome = await Promise.race([consumption, deadline]);
+      if (outcome === "serialized") {
+        assert.equal(existsSync(path), true, "worker must retain published inode until publisher finishes its identity assertions");
+        publicationFenced = true;
+      }
+    } });
+    await worker;
+    assert.equal(publicationFenced, true, "worker must contend with the publisher's per-job writer");
+    assert.equal(observedClosure, true);
+    assert.equal(receipt.status, "cancelled");
+    assert.equal(receipt.ownerToken, ownerToken);
+    assert.equal(receipt.specDigest, specDigest);
+    assert.equal(receipt.childPid, acknowledged.childPid);
+    assert.equal(receipt.workerPid, acknowledged.workerPid);
+    assert.equal(receipt.cancelDelivered, true);
+    assert.ok(receipt.cancelConfirmedAt);
+    assert.equal(existsSync(cancelRequestPath(stateRoot, jobId)), false);
+  } finally {
+    clearTimeout(timer);
+    await worker?.catch(() => undefined);
+    process.exitCode = savedExitCode;
+    await cleanup();
+  }
+});
+
 async function createWorkerTestState(): Promise<{ stateRoot: string; cleanup: () => Promise<void> }> {
   const dir = join(canonicalFixturePath(tmpdir()), `test-job-worker-${Date.now()}-${Math.random().toString(36).slice(2)}`);
   await mkdir(dir, { recursive: true, mode: 0o700 });
