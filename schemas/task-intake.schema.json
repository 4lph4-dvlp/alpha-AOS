{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alpha-aos.local/schemas/task-intake.schema.json",
  "title": "alpha-AOS task intake request and handoff",
  "description": "Closed bounded task intake request and handoff interchange (ENTRY-01, ENTRY-05, ENTRY-06).",
  "type": "object",
  "required": ["schemaVersion", "request"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "projectRoot": {
      "type": "string",
      "maxLength": 1024
    },
    "boundProjectRoot": {
      "type": "string",
      "maxLength": 1024
    },
    "request": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 8192
        },
        "shortGoal": {
          "type": "string",
          "maxLength": 512
        },
        "shortScope": {
          "type": "string",
          "maxLength": 1024
        }
      }
    },
    "explicit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string",
          "maxLength": 512
        },
        "style": {
          "type": "string",
          "maxLength": 512
        },
        "phase": {
          "type": "string",
          "maxLength": 512
        },
        "arguments": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "maxLength": 512
          }
        }
      }
    },
    "currentTask": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "taskId": {
          "type": "string",
          "maxLength": 512
        },
        "runId": {
          "type": "string",
          "maxLength": 512
        },
        "contractDigest": {
          "type": "string",
          "maxLength": 512
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "selectedStyle": {
          "type": "string",
          "maxLength": 512
        },
        "artifactPath": {
          "type": "string",
          "maxLength": 1024
        },
        "relationship": {
          "type": "string",
          "enum": [
            "follow-up",
            "test-repair",
            "verification",
            "status",
            "independent",
            "unknown"
          ]
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "maxLength": 512
        },
        "target": {
          "type": "string",
          "maxLength": 512
        },
        "result": {
          "type": "string",
          "maxLength": 512
        },
        "boundedImpact": {
          "type": "boolean"
        },
        "remote": {
          "type": "string",
          "maxLength": 512
        },
        "branch": {
          "type": "string",
          "maxLength": 512
        },
        "localRef": {
          "type": "string",
          "maxLength": 512
        },
        "force": {
          "type": "boolean"
        },
        "delete": {
          "type": "boolean"
        },
        "mirror": {
          "type": "boolean"
        },
        "historyRewrite": {
          "type": "boolean"
        },
        "conflictResolution": {
          "type": "boolean"
        },
        "oldPath": {
          "type": "string",
          "maxLength": 1024
        },
        "newPath": {
          "type": "string",
          "maxLength": 1024
        },
        "unchangedApiMeaning": {
          "type": "boolean"
        },
        "sourcePath": {
          "type": "string",
          "maxLength": 1024
        },
        "targetLink": {
          "type": "string",
          "maxLength": 1024
        },
        "scopedPaths": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "faithful": {
          "type": "boolean"
        },
        "redesign": {
          "type": "boolean"
        },
        "newFeatureScope": {
          "type": "boolean"
        }
      }
    },
    "scopeChange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "previousOperationId": {
          "type": "string",
          "maxLength": 512
        },
        "expandedScope": {
          "type": "boolean"
        },
        "requiresInvestigation": {
          "type": "boolean"
        },
        "wipBytesPreserved": {
          "type": "boolean"
        },
        "isTaskRepair": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "maxLength": 512
        }
      }
    },
    "questionCapability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "supportsSixOptions": {
          "type": "boolean"
        },
        "style": {
          "type": "string",
          "enum": ["native", "numbered-text", "unknown"]
        }
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "raw": {
          "type": "string",
          "maxLength": 512
        },
        "canonicalStyle": {
          "type": "string",
          "maxLength": 512
        },
        "pendingTaskId": {
          "type": "string",
          "maxLength": 512
        }
      }
    },
    "facts": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["fact", "status", "provenance"],
        "additionalProperties": false,
        "properties": {
          "fact": {
            "type": "string",
            "maxLength": 512
          },
          "status": {
            "type": "string",
            "enum": ["known", "unknown", "contradicted"]
          },
          "provenance": {
            "type": "string",
            "enum": [
              "user-explicit",
              "filesystem",
              "git",
              "gsd-artifact",
              "contract-run",
              "host-capability"
            ]
          },
          "detail": {
            "type": "string",
            "maxLength": 512
          }
        }
      }
    },
    "executionRoute": {
      "$ref": "#/$defs/executionRoute"
    }
  },
  "$defs": {
    "handoff": {
      "type": "object",
      "required": [
        "schemaVersion",
        "originalRequest",
        "knownFacts",
        "policyRevision",
        "nextAction"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "originalRequest": {
          "type": "string",
          "maxLength": 8192
        },
        "shortGoal": {
          "type": "string",
          "maxLength": 512
        },
        "shortScope": {
          "type": "string",
          "maxLength": 1024
        },
        "knownFacts": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": ["fact", "status", "provenance"],
            "additionalProperties": false,
            "properties": {
              "fact": {
                "type": "string",
                "maxLength": 512
              },
              "status": {
                "type": "string",
                "enum": ["known", "unknown", "contradicted"]
              },
              "provenance": {
                "type": "string",
                "enum": [
                  "user-explicit",
                  "filesystem",
                  "git",
                  "gsd-artifact",
                  "contract-run",
                  "host-capability"
                ]
              },
              "detail": {
                "type": "string",
                "maxLength": 512
              }
            }
          }
        },
        "commandRoute": {
          "type": "object",
          "required": ["command", "workflow", "arguments"],
          "additionalProperties": false,
          "properties": {
            "command": {
              "type": "string",
              "maxLength": 512
            },
            "workflow": {
              "type": "string",
              "maxLength": 512
            },
            "phase": {
              "type": "string",
              "maxLength": 512
            },
            "arguments": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "string",
                "maxLength": 512
              }
            },
            "stoppingPoint": {
              "type": "string",
              "maxLength": 512
            }
          }
        },
        "selectedStyle": {
          "type": "string",
          "enum": [
            "conversational-quick",
            "conversational-quick-full",
            "conversational-phase",
            "autopilot-quick",
            "autopilot-quick-full",
            "autopilot-phase"
          ]
        },
        "taskReference": {
          "type": "string",
          "maxLength": 512
        },
        "policyRevision": {
          "type": "string",
          "maxLength": 128
        },
        "nextAction": {
          "type": "string",
          "enum": [
            "choose-style",
            "adaptive-intake",
            "ask-clarification",
            "execute-explicit",
            "continue-task",
            "execute-simple"
          ]
        },
        "executionRoute": {
          "$ref": "#/$defs/executionRoute"
        }
      }
    },
    "executionRoute": {
      "type": "object",
      "required": [
        "style",
        "label",
        "surface",
        "workflow",
        "command",
        "arguments",
        "authorityRequirements"
      ],
      "additionalProperties": false,
      "properties": {
        "style": {
          "type": "string",
          "enum": [
            "conversational-quick",
            "conversational-quick-full",
            "conversational-phase",
            "autopilot-quick",
            "autopilot-quick-full",
            "autopilot-phase"
          ]
        },
        "label": {
          "type": "string",
          "maxLength": 128
        },
        "surface": {
          "type": "string",
          "enum": ["conversation", "isolated-runner"]
        },
        "workflow": {
          "type": "string",
          "maxLength": 128
        },
        "command": {
          "type": "string",
          "maxLength": 128
        },
        "phase": {
          "type": "string",
          "maxLength": 128
        },
        "arguments": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 512
          }
        },
        "quickQuality": {
          "type": "string",
          "enum": ["standard", "full"]
        },
        "stoppingPoint": {
          "type": "string",
          "maxLength": 128
        },
        "authorityRequirements": {
          "type": "object",
          "required": [
            "executionAuthorized",
            "requiresExactApproval",
            "requiresSeparateStart",
            "requiresEvidenceValidation",
            "surface"
          ],
          "additionalProperties": false,
          "properties": {
            "executionAuthorized": {
              "type": "boolean",
              "const": false
            },
            "requiresExactApproval": {
              "type": "boolean"
            },
            "requiresSeparateStart": {
              "type": "boolean"
            },
            "requiresEvidenceValidation": {
              "type": "boolean"
            },
            "surface": {
              "type": "string",
              "enum": ["conversation", "isolated-runner"]
            }
          }
        }
      }
    }
  }
}
