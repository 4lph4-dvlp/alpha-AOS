{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alpha-aos.local/schemas/tool-release-record.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "eventId", "operationId", "sequence", "occurredAt", "kind"],
  "properties": {
    "schemaVersion": {"const": 1},
    "eventId": {"$ref": "#/$defs/id"}, "operationId": {"$ref": "#/$defs/id"},
    "sequence": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "occurredAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$", "maxLength": 32},
    "kind": {"enum": ["started", "tool-result", "finished"]},
    "requests": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/request"}},
    "result": {"$ref": "#/$defs/result"},
    "results": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/result"}},
    "outcome": {"enum": ["succeeded", "failed", "partial", "interrupted"]},
    "acceptedTransitions": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/transition"}}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "started"}}}, "then": {"properties": {"requests": true, "result": false, "results": false, "outcome": false, "acceptedTransitions": false}, "required": ["requests"]}},
    {"if": {"properties": {"kind": {"const": "tool-result"}}}, "then": {"properties": {"requests": false, "result": true, "results": false, "outcome": false, "acceptedTransitions": false}, "required": ["result"]}},
    {"if": {"properties": {"kind": {"const": "finished"}}}, "then": {"properties": {"requests": false, "result": false, "results": true, "outcome": true, "acceptedTransitions": true}, "required": ["results", "outcome", "acceptedTransitions"]}}
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "tool": {"type": "string", "maxLength": 80, "pattern": "^(cua-driver|gsd|ecc|mcp:(context7|exa|firecrawl)|bridge:pi)$"},
    "version": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "request": {"type": "object", "additionalProperties": false, "required": ["toolId", "selector", "exact"], "properties": {"toolId": {"$ref": "#/$defs/tool"}, "selector": {"$ref": "#/$defs/version"}, "exact": {"type": "boolean"}}},
    "resolved": {"type": "object", "additionalProperties": false, "required": ["release", "artifact", "platform", "architecture", "digest", "sourceId", "sourceUrl"], "properties": {"release": {"$ref": "#/$defs/version"}, "artifact": {"$ref": "#/$defs/version"}, "platform": {"enum": ["windows", "macos", "linux"]}, "architecture": {"enum": ["x64", "arm64", "universal"]}, "digest": {"$ref": "#/$defs/digest"}, "sourceId": {"enum": ["driver-release", "npm-registry", "github-release"]}, "sourceUrl": {"type": "string", "maxLength": 512}}},
    "installed": {"type": "object", "additionalProperties": false, "required": ["installationId", "version", "pathAlias"], "properties": {"installationId": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/version"}, "pathAlias": {"type": "string", "maxLength": 256, "pattern": "^[A-Za-z0-9._/+-]+$"}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["proofId", "subject", "target", "method", "result", "platform", "architecture", "harness"], "properties": {"proofId": {"$ref": "#/$defs/id"}, "subject": {"$ref": "#/$defs/id"}, "target": {"enum": ["installation", "integrity", "integration"]}, "method": {"enum": ["sha256", "signature", "invocation", "discovery"]}, "result": {"enum": ["pass", "fail", "unknown"]}, "platform": {"enum": ["windows", "macos", "linux"]}, "architecture": {"enum": ["x64", "arm64", "universal"]}, "harness": {"enum": ["claude", "codex", "antigravity", "pi", "hermes", null]}}},
    "result": {"type": "object", "additionalProperties": false, "required": ["toolId", "requested", "resolved", "installed", "verified", "evidence", "outcome"], "properties": {"toolId": {"$ref": "#/$defs/tool"}, "requested": {"$ref": "#/$defs/request"}, "resolved": {"anyOf": [{"$ref": "#/$defs/resolved"}, {"type": "null"}]}, "installed": {"anyOf": [{"$ref": "#/$defs/installed"}, {"type": "null"}]}, "verified": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}, "evidence": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/evidence"}}, "outcome": {"enum": ["succeeded", "failed", "unknown"]}}},
    "transition": {"type": "object", "additionalProperties": false, "required": ["toolId", "installationId", "proofId", "priorDigest"], "properties": {"toolId": {"$ref": "#/$defs/tool"}, "installationId": {"$ref": "#/$defs/id"}, "proofId": {"$ref": "#/$defs/id"}, "priorDigest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}}}
  }
}
