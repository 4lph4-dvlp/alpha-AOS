+/** Publication must finish its inode checks before the owner consumes a marker. */
+export async function consumeCommandJobCancelRequest(options: {
+  stateRoot: string;
+  expectedIdentity: ExpectedJobIdentity;
+  _onContention?: (() => void | Promise<void>) | undefined;
+}): Promise<CancelRequestPayload | null> {
+  const { stateRoot, expectedIdentity } = options;
+  return withJobWriteLock(stateRoot, expectedIdentity.jobId, async () => {
+    const path = cancelRequestPath(stateRoot, expectedIdentity.jobId);
+    if (!existsSync(path)) return null;
+    const parentProof = await provePlainJobPath(dirname(path), stateRoot, "state");
+    const identity = jobFileIdentity(await lstat(path));
+    const raw = await readBoundedFile(path, stateRoot, MAX_CANCEL_REQUEST_BYTES);
+    const current = await readJobRecord(stateRoot, expectedIdentity.jobId);
+    assertJobIdentityMatch(current, expectedIdentity, "cancel");
+    const payload = validateCancelRequest(JSON.parse(raw), current);
+    await unlinkOwnedJobFile(path, identity, parentProof);
+    return payload;
+  }, options._onContention);
+}
