{
  "name": "alpha-aos",
  "version": "0.1.0",
  "description": "Declarative installer and updater for the alpha-AOS agent workflow stack",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/4lph4-dvlp/alpha-AOS.git"
  },
  "bugs": {
    "url": "https://github.com/4lph4-dvlp/alpha-AOS/issues"
  },
  "homepage": "https://github.com/4lph4-dvlp/alpha-AOS#readme",
  "type": "module",
  "files": [
    "dist/src/",
    "catalog/",
    "schemas/",
    "scripts/",
    "skills/",
    "README.md",
    "docs/"
  ],
  "bin": {
    "alpha-aos": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-artifact.mjs write",
    "build:check": "node scripts/build-artifact.mjs check",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start": "node dist/src/cli.js"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "ajv": "8.20.0",
    "jsonc-parser": "3.3.1",
    "smol-toml": "1.8.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "24.7.2",
    "typescript": "5.9.3"
  }
}
