{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alpha-aos.local/schemas/project-stack.schema.json",
  "type": "object",
  "required": [
    "schemaVersion"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer"
    },
    "trusted": {
      "type": "boolean"
    },
    "packs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "criticalUserFlows": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scientificResearch": {
      "type": "boolean"
    },
    "isolation": {
      "type": "object",
      "required": [
        "mode",
        "allowedHarnesses",
        "exclusive",
        "inherit",
        "allowedSkills",
        "allowedMcp",
        "execution"
      ],
      "properties": {
        "mode": {
          "enum": [
            "managed",
            "project-only",
            "sealed"
          ]
        },
        "allowedHarnesses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "claude",
              "codex",
              "antigravity",
              "pi",
              "hermes"
            ]
          }
        },
        "exclusive": {
          "type": "boolean"
        },
        "inherit": {
          "type": "object",
          "required": [
            "globalConfig",
            "globalSkills",
            "globalMcp",
            "globalMemory",
            "globalHooks"
          ],
          "properties": {
            "globalConfig": {
              "type": "boolean"
            },
            "globalSkills": {
              "type": "boolean"
            },
            "globalMcp": {
              "type": "boolean"
            },
            "globalMemory": {
              "type": "boolean"
            },
            "globalHooks": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "allowedSkills": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowedMcp": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "execution": {
          "type": "object",
          "required": [
            "isolation",
            "network",
            "environment"
          ],
          "properties": {
            "isolation": {
              "enum": [
                "process",
                "container"
              ]
            },
            "network": {
              "enum": [
                "inherited",
                "disabled",
                "allowlist"
              ]
            },
            "environment": {
              "enum": [
                "inherited",
                "allowlist"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "title": "alpha-AOS project stack manifest",
  "description": "Closed-world contract for the alpha-AOS-owned project manifest. Repository-local user-owned files live outside this document and are never normalized or removed."
}
