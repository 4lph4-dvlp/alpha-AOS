{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Computer use hash-chained event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sequence",
    "previous",
    "runId",
    "at",
    "kind",
    "data",
    "hash"
  ],
  "properties": {
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5000
    },
    "previous": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][A-Za-z0-9_-]{0,95}$"
    },
    "at": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "kind": {
      "enum": [
        "intent",
        "result",
        "decision",
        "tombstone"
      ]
    },
    "data": {
      "type": "object",
      "maxProperties": 20
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
