{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alpha-aos.local/schemas/stack.schema.json",
  "type": "object",
  "required": ["schemaVersion", "name", "defaultChannel", "harnesses", "components", "policy"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "const": "alpha-aos" },
    "defaultChannel": { "enum": ["stable", "candidate", "pinned"] },
    "harnesses": { "type": "object", "minProperties": 1 },
    "components": { "type": "object" },
    "policy": { "type": "object" }
  },
  "additionalProperties": true
}
