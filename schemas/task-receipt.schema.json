{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alpha-aos.local/schemas/task-receipt.schema.json",
  "title": "alpha-AOS task receipt",
  "description": "Closed managed-state records under <state>/tasks/<contractId>/ (D-01, D-02, D-16). A task-approval record binds one exact contract digest to an explicit single-run consent; a task-run record binds the contract revision and digest, the artifact digest, the measurements and the independent review into one verdict.",
  "oneOf": [{ "$ref": "#/$defs/approval" }, { "$ref": "#/$defs/run" }],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "contractId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "criterionId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$" },
    "measurement": {
      "type": "object",
      "required": ["criterionId", "outcome", "exitCode", "stdoutSha256", "detail", "cause", "measuredBy", "substituteDecisionId"],
      "additionalProperties": false,
      "properties": {
        "criterionId": { "$ref": "#/$defs/criterionId" },
        "outcome": { "enum": ["pass", "fail", "unavailable"] },
        "exitCode": { "type": ["integer", "null"] },
        "stdoutSha256": {
          "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "detail": { "type": "string", "maxLength": 1000 },
        "cause": { "enum": ["none", "entry-missing", "timeout", "output-capped", "spawn-failed"] },
        "measuredBy": { "enum": ["contract", "substitute"] },
        "substituteDecisionId": { "type": ["string", "null"], "maxLength": 64 }
      }
    },
    "row": {
      "type": "object",
      "required": ["criterionId", "verdict", "measured", "review", "artifactDigest", "reason", "nextAction"],
      "additionalProperties": false,
      "properties": {
        "criterionId": { "$ref": "#/$defs/criterionId" },
        "verdict": { "enum": ["pass", "fail", "unknown"] },
        "measured": { "$ref": "#/$defs/measurement" },
        "review": {
          "anyOf": [
            {
              "type": "object",
              "required": ["verdict", "severity", "evidence", "confirmed", "confirmationDetail"],
              "additionalProperties": false,
              "properties": {
                "verdict": { "enum": ["pass", "fail", "unknown"] },
                "severity": { "enum": ["blocking", "advisory"] },
                "evidence": { "type": "string" },
                "confirmed": { "type": ["boolean", "null"] },
                "confirmationDetail": { "type": ["string", "null"], "maxLength": 1000 }
              }
            },
            { "type": "null" }
          ]
        },
        "artifactDigest": { "$ref": "#/$defs/sha256" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "nextAction": { "type": ["string", "null"] }
      }
    },
    "precondition": {
      "type": "object",
      "required": ["id", "satisfied", "reason", "nextAction"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "satisfied": { "type": "boolean" },
        "reason": { "type": "string", "maxLength": 1000 },
        "nextAction": { "type": "string", "maxLength": 1000 }
      }
    },
    "decision": {
      "description": "One controller decision copied from .alpha-aos/task-runs/<runId>/decisions.jsonl (CON-02, D-06). A substitute carries only an entry path, so a decision cannot change what a criterion measures (D-08).",
      "type": "object",
      "required": ["id", "at", "category", "choice", "rationale", "criterionIds", "substitute"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "at": { "type": "string", "minLength": 1, "maxLength": 64 },
        "category": {
          "enum": ["implementation", "file-layout", "verification", "dependency", "measurement-substitute", "gsd-default"]
        },
        "choice": { "type": "string", "minLength": 1, "maxLength": 500 },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "criterionIds": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/criterionId" } },
        "substitute": {
          "anyOf": [
            {
              "type": "object",
              "required": ["criterionId", "entry"],
              "additionalProperties": false,
              "properties": {
                "criterionId": { "$ref": "#/$defs/criterionId" },
                "entry": { "type": "string", "minLength": 1, "maxLength": 500 }
              }
            },
            { "type": "null" }
          ]
        }
      }
    },
    "reviewReport": {
      "description": "The reviewer report as received. Re-validated against schemas/task-review.schema.json whenever it is read.",
      "type": "object"
    },
    "approval": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "contractId",
        "revision",
        "contractDigest",
        "approvedAt",
        "canonicalProjectRoot",
        "consent",
        "contract"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "task-approval" },
        "contractId": { "$ref": "#/$defs/contractId" },
        "revision": { "type": "integer", "minimum": 1 },
        "contractDigest": { "$ref": "#/$defs/sha256" },
        "approvedAt": { "type": "string", "minLength": 1 },
        "canonicalProjectRoot": { "type": "string", "minLength": 1 },
        "gitDirectory": {
          "description": "The canonical git directory the approved local-commit effect lets the controller write, or null when none is grantable. Absent on approvals recorded before git-directory binding, which the start gate refuses for a grantable project.",
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "consent": {
          "type": "object",
          "required": ["mode", "grant", "scope"],
          "additionalProperties": false,
          "properties": {
            "mode": { "const": "autopilot" },
            "grant": { "const": "explicit-cli-approval" },
            "scope": { "const": "single-run" }
          }
        },
        "contract": {
          "description": "The digestable contract view that was approved. Re-digested on every read.",
          "type": "object"
        }
      }
    },
    "run": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "runId",
        "contractId",
        "revision",
        "contractDigest",
        "status",
        "startedAt",
        "finishedAt",
        "artifact",
        "executor",
        "reviewer",
        "verdict",
        "stopReason",
        "nextAction",
        "decisions",
        "decisionLog",
        "baseCommit",
        "deadlineAt",
        "gsd",
        "effects"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "task-run" },
        "runId": { "type": "string", "pattern": "^[0-9a-z]{8,}-[0-9a-f]{8}$" },
        "contractId": { "$ref": "#/$defs/contractId" },
        "revision": { "type": "integer", "minimum": 1 },
        "contractDigest": { "$ref": "#/$defs/sha256" },
        "status": { "enum": ["executing", "accepted", "rejected", "unknown", "blocked", "stopped"] },
        "startedAt": { "type": "string", "minLength": 1 },
        "finishedAt": { "type": ["string", "null"] },
        "artifact": {
          "anyOf": [
            {
              "type": "object",
              "required": ["digest", "fileCount", "totalBytes"],
              "additionalProperties": false,
              "properties": {
                "digest": { "$ref": "#/$defs/sha256" },
                "fileCount": { "type": "integer", "minimum": 0 },
                "totalBytes": { "type": "integer", "minimum": 0 }
              }
            },
            { "type": "null" }
          ]
        },
        "executor": {
          "anyOf": [
            {
              "type": "object",
              "required": ["harness", "version", "executable", "sessionId", "exitCode", "processCode", "terminal", "claim"],
              "additionalProperties": false,
              "properties": {
                "harness": { "type": "string", "minLength": 1 },
                "version": { "type": ["string", "null"] },
                "executable": { "type": ["string", "null"] },
                "sessionId": { "type": ["string", "null"] },
                "exitCode": { "type": ["integer", "null"] },
                "processCode": { "type": "string" },
                "terminal": { "type": "string" },
                "claim": {
                  "anyOf": [
                    {
                      "type": "object",
                      "required": ["status", "summary", "authorityRequest", "gsdQuickId"],
                      "additionalProperties": false,
                      "properties": {
                        "status": { "enum": ["completed", "needs-authority", "failed"] },
                        "summary": { "type": "string" },
                        "authorityRequest": { "type": ["object", "null"] },
                        "gsdQuickId": { "type": ["string", "null"] }
                      }
                    },
                    { "type": "null" }
                  ]
                },
                "detail": { "type": ["string", "null"] }
              }
            },
            { "type": "null" }
          ]
        },
        "reviewer": {
          "anyOf": [
            {
              "type": "object",
              "required": ["harness", "version", "executable", "sessionId", "requestId", "requestedSessionId", "report"],
              "additionalProperties": false,
              "properties": {
                "harness": { "type": "string", "minLength": 1 },
                "version": { "type": ["string", "null"] },
                "executable": { "type": ["string", "null"] },
                "sessionId": { "type": ["string", "null"] },
                "requestId": { "type": "string", "minLength": 1 },
                "requestedSessionId": { "type": "string", "minLength": 1 },
                "report": {
                  "anyOf": [{ "$ref": "#/$defs/reviewReport" }, { "type": "null" }]
                }
              }
            },
            { "type": "null" }
          ]
        },
        "verdict": {
          "anyOf": [
            {
              "type": "object",
              "required": ["overall", "refusal", "rows", "preconditions"],
              "additionalProperties": false,
              "properties": {
                "overall": { "enum": ["accepted", "rejected", "unknown"] },
                "refusal": { "enum": ["stale-review", "stale-artifact", null] },
                "rows": { "type": "array", "items": { "$ref": "#/$defs/row" } },
                "preconditions": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/precondition" } }
              }
            },
            { "type": "null" }
          ]
        },
        "stopReason": { "type": ["string", "null"] },
        "nextAction": { "type": ["string", "null"] },
        "decisions": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/decision" } },
        "decisionLog": {
          "description": "Null until the decision log is read; an invalid log names its first bad line and contributes no decision.",
          "anyOf": [
            {
              "type": "object",
              "required": ["status", "reason"],
              "additionalProperties": false,
              "properties": {
                "status": { "enum": ["absent", "valid", "invalid"] },
                "reason": { "type": ["string", "null"], "maxLength": 1000 }
              }
            },
            { "type": "null" }
          ]
        },
        "baseCommit": {
          "description": "The clean commit the run started from; every changed path is measured against it.",
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "deadlineAt": {
          "description": "When the approved maxWallTimeMinutes elapses, or null when the contract sets no limit.",
          "type": ["string", "null"]
        },
        "gsd": {
          "description": "GSD quick's own evidence as read by alpha-AOS (RUN-01). alpha-AOS never writes it; not-run means the run ended before it was read.",
          "anyOf": [
            {
              "type": "object",
              "required": ["status", "quickId", "planPath", "summaryPath", "stateRow", "commits", "missing", "workflowSha256"],
              "additionalProperties": false,
              "properties": {
                "status": { "enum": ["verified", "missing", "not-run"] },
                "quickId": { "type": ["string", "null"], "maxLength": 255 },
                "planPath": { "type": ["string", "null"] },
                "summaryPath": { "type": ["string", "null"] },
                "stateRow": { "type": "boolean" },
                "commits": { "type": "array", "items": { "$ref": "#/$defs/commit" } },
                "missing": { "type": "array", "items": { "type": "string" } },
                "workflowSha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
              }
            },
            { "type": "null" }
          ]
        },
        "effects": {
          "description": "Every path changed after the base commit, split into implementation, GSD .planning/ and violation paths (D-03, AUTO-02), plus the read-only dependency checkpoint (D-07).",
          "anyOf": [
            {
              "type": "object",
              "required": ["implementationPaths", "planningPaths", "violations", "dependencyChanged", "dependencyPaths", "packCheckpoint"],
              "additionalProperties": false,
              "properties": {
                "implementationPaths": { "type": "array", "items": { "type": "string" } },
                "planningPaths": { "type": "array", "items": { "type": "string" } },
                "violations": { "type": "array", "items": { "$ref": "#/$defs/violation" } },
                "dependencyChanged": { "type": "boolean" },
                "dependencyPaths": { "type": "array", "items": { "type": "string" } },
                "packCheckpoint": {
                  "anyOf": [
                    {
                      "type": "object",
                      "required": ["planDigest", "selected", "applicable", "approveCommand"],
                      "additionalProperties": false,
                      "properties": {
                        "planDigest": { "$ref": "#/$defs/sha256" },
                        "selected": { "type": "array", "items": { "type": "string" } },
                        "applicable": { "type": "array", "items": { "type": "string" } },
                        "approveCommand": { "type": "string", "minLength": 1 }
                      }
                    },
                    { "type": "null" }
                  ]
                }
              }
            },
            { "type": "null" }
          ]
        },
        "gitDirectory": {
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        }
      }
    },
    "commit": {
      "type": "object",
      "required": ["sha", "subject"],
      "additionalProperties": false,
      "properties": {
        "sha": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        "subject": { "type": "string" }
      }
    },
    "violation": {
      "type": "object",
      "required": ["effect", "path", "detail"],
      "additionalProperties": false,
      "properties": {
        "effect": { "enum": ["workspace-write", "local-commit", "dependency-change"] },
        "path": { "type": "string" },
        "detail": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    }
  }
}
