{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alpha-aos.local/schemas/transaction-journal.schema.json",
  "title": "alpha-AOS transaction journal",
  "description": "Write-ahead record of one managed mutation. Every entry is durable before its target changes, so an interruption is always classifiable against the recorded hashes.",
  "type": "object",
  "required": ["schemaVersion", "id", "createdAt", "status", "allowedRoots", "files"],
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
  },
  "properties": {
    "schemaVersion": { "type": "integer" },
    "id": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "minLength": 1 },
    "status": { "enum": ["applying", "applied", "rolled-back", "failed"] },
    "allowedRoots": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "directorySyncSupported": {
      "description": "False where the filesystem could not flush a directory entry; recorded as a capability rather than assumed.",
      "type": "boolean"
    },
    "repairedAt": { "type": "string", "minLength": 1 },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target", "existed", "snapshot", "beforeHash", "afterHash", "proofDigest"],
        "additionalProperties": false,
        "properties": {
          "target": { "type": "string", "minLength": 1 },
          "existed": { "type": "boolean" },
          "snapshot": { "type": ["string", "null"] },
          "beforeHash": { "$ref": "#/$defs/sha256" },
          "afterHash": { "$ref": "#/$defs/sha256" },
          "proofDigest": {
            "description": "Binds this entry to the path proof that authorized it.",
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
