{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alpha-aos.local/schemas/controller-lock.schema.json",
  "title": "alpha-AOS project-local controller lease lock",
  "description": "Strict JSON schema for project-local controller lease lock files (.alpha-aos/controller.lock) (ROL-03, D-05, D-08).",
  "type": "object",
  "required": [
    "schemaVersion",
    "harness",
    "token",
    "pid",
    "host",
    "startedAt",
    "contractDigest"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1] },
    "harness": {
      "type": "string",
      "enum": ["claude", "codex", "antigravity", "pi", "hermes"]
    },
    "token": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "pid": {
      "type": "integer",
      "minimum": 1
    },
    "host": {
      "type": "string",
      "minLength": 1
    },
    "startedAt": {
      "type": "string",
      "minLength": 1
    },
    "contractDigest": {
      "type": "string",
      "minLength": 1
    }
  }
}
